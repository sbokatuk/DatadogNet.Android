<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <DatadogArtifact>dd-sdk-android-session-replay</DatadogArtifact>
    <DatadogPackageName>SessionReplay</DatadogPackageName>
    <Description>.NET for Android / .NET MAUI bindings for the native Datadog Android SDK's dd-sdk-android-session-replay module: Session Replay recording, with the TextAndInputPrivacy, ImagePrivacy and TouchPrivacy masking levels applied on the device before anything is uploaded. Built against dd-sdk-android $(DatadogNativeVersion). Requires RUM - add DatadogNet.RUM.Android. Add DatadogNet.SessionReplayMaterial.Android or DatadogNet.SessionReplayCompose.Android for apps built on Material Components or Jetpack Compose.</Description>
    <PackageTags>datadog-session-replay;session-replay</PackageTags>
  </PropertyGroup>

  <Import Project="../Datadog.Binding.props" />

  <ItemGroup>
    <ProjectReference Include="../DatadogNet.Core.Android/DatadogNet.Core.Android.csproj"
                      JavaArtifact="com.datadoghq:dd-sdk-android-core:$(DatadogNativeVersion)" />
    <ProjectReference Include="../DatadogNet.Internal.Android/DatadogNet.Internal.Android.csproj"
                      JavaArtifact="com.datadoghq:dd-sdk-android-internal:$(DatadogNativeVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Square.OkHttp3" Version="$(OkHttpVersion)" />
    <PackageReference Include="GoogleGson" Version="$(GsonVersion)" />
    <PackageReference Include="Xamarin.AndroidX.AppCompat" Version="$(AndroidXAppCompatVersion)" />
  </ItemGroup>

</Project>
