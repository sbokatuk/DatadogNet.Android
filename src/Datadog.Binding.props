<!--
  Everything the thirteen binding projects have in common.

  Imported explicitly by each .csproj rather than picked up as a Directory.Build.props, because it
  reads properties the project sets - DatadogArtifact and DatadogPackageName - and
  Directory.Build.props is imported before the project body, so it would see neither. That leaves
  each binding project as its identity, its description, and its dependencies.
-->
<Project>

  <PropertyGroup>
    <!--
      Each .NET SDK's Android workload ships reference packs for exactly two target frameworks: the
      .NET 9 band covers net8.0-android + net9.0-android, the .NET 10 band covers net9.0-android +
      net10.0-android. No single SDK can build all three, so BuildNugets.sh packs twice and merges
      the results - see build/merge-packages.py. DatadogSdkBand selects which pass this build is.

      The API level is pinned per target framework rather than left to the workload's default,
      because it ends up in the lib/<tfm>/ folder name inside the package. A bare 'net8.0-android'
      resolves to whatever the installed workload currently defaults to, so a workload update would
      change the packages' advertised target frameworks without a single source edit - and would do
      it to only whichever of the two passes ran on the updated machine.
    -->
    <DatadogSdkBand Condition=" '$(DatadogSdkBand)' == '' ">net9</DatadogSdkBand>
    <TargetFrameworks Condition=" '$(DatadogSdkBand)' == 'net9' ">net8.0-android34.0;net9.0-android35.0</TargetFrameworks>
    <TargetFrameworks Condition=" '$(DatadogSdkBand)' == 'net10' ">net10.0-android36.0</TargetFrameworks>

    <!--
      A package can opt out of net8 when a dependency it cannot do without has itself dropped it.
      Only DatadogNet.SessionReplayCompose.Android does: Compose's last net8 build pins an AndroidX
      SavedState old enough to collide with what MAUI resolves, and holding every package back to
      match would break MAUI consumers of all thirteen to keep net8 for one.

      The package tests know which packages this applies to, so a package silently losing net8
      fails rather than shipping one fewer target framework than it claims.
    -->
    <TargetFrameworks Condition=" '$(DatadogSdkBand)' == 'net9' and '$(DatadogSkipNet8)' == 'true' ">net9.0-android35.0</TargetFrameworks>
    <!--
      net8.0-android is past end of support, which the SDK reports as an error. It ships
      deliberately: .NET 8 is still where a large share of MAUI apps are, and stranding them would
      defeat the point of publishing bindings at all.
    -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <CheckEolWorkloads>false</CheckEolWorkloads>

    <!--
      dd-sdk-android 3.x raised its floor from API 21 to API 23 (Android 6.0); see
      buildSrc/.../AndroidConfig.kt upstream. A package claiming less would be claiming support for
      OS versions its own .aar refuses to install on.
    -->
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>

    <!--
      class-parse reads the .aar's class files directly rather than running javadoc over sources,
      which is the only option that works against a binary-only Maven artifact. XAJavaInterop1 is
      the modern codegen target; the legacy XamarinAndroid one is not supported for new bindings.
    -->
    <AndroidClassParser>class-parse</AndroidClassParser>
    <AndroidCodegenTarget>XAJavaInterop1</AndroidCodegenTarget>

    <!--
      The namespace follows the Java package the module actually declares, projected by the
      generator - com.datadog.android.rum becomes Com.Datadog.Android.Rum. Left at the default
      rather than flattened to something shorter, so that a type's C# name can always be derived
      from its Kotlin one without a lookup table.
    -->
    <AssemblyName>DatadogNet.$(DatadogPackageName).Android</AssemblyName>
    <!--
      Deliberately NOT the default, which is the project name. .NET Android emits a Resource
      designer class into $(RootNamespace), so a default of DatadogNet.Logs.Android would bring the
      namespace DatadogNet.Logs into existence - and C# resolves a bare `Logs` outward through
      enclosing namespaces, so in any consumer under a DatadogNet.* namespace `Logs.Enable(...)`
      would bind to that namespace instead of Com.Datadog.Android.Log.Logs and fail to compile.
      The same trap applies to Trace, SessionReplay and Core.

      This repository's own sample and device tests live under DatadogNet.Android.*, so they hit it
      immediately; a consumer whose app is called DatadogNet.Something would hit it too, and would
      have no idea why.
    -->
    <RootNamespace>DatadogNet.Bindings.$(DatadogPackageName)</RootNamespace>

    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      CS1591: the generated binding has no XML doc comments.
      BG8604/BG8605: Kotlin emits synthetic $default bridge methods for every function with default
      parameter values, and dd-sdk-android's public API uses them pervasively (RumMonitor alone has
      them on nearly every member). The generator reports the ones it cannot name; the real
      overloads that @JvmOverloads produces are bound and are what consumers call.
    -->
    <NoWarn>$(NoWarn);CS1591;BG8604;BG8605</NoWarn>
  </PropertyGroup>

  <Target Name="ValidateDatadogSdkBand" BeforeTargets="Build;Pack" Condition=" '$(TargetFrameworks)' == '' ">
    <Error Text="DatadogSdkBand must be 'net9' or 'net10', but was '$(DatadogSdkBand)'." />
  </Target>

  <!--
    The native artifact, resolved straight from Maven Central along with its .pom. Nothing is
    committed to this repository and there is no fetch script: @(AndroidMavenLibrary) downloads
    into ~/.cache/dotnet-android/MavenCacheDirectory, which CI restores from actions/cache.

    This also feeds @(AndroidAdditionalJavaManifest), which drives the SDK's Java dependency
    verification - the check that fails the build when the .aar links against Java types no
    referenced package provides. That check is the whole reason to prefer this over committing
    .aar files: it turns a runtime NoClassDefFoundError into a build error.
  -->
  <!--
    DatadogBindArtifact=false ships the .aar without generating a C# binding for it. The classes
    are still dexed into the consuming app, which is the point: a module whose types nobody calls
    from C# still has to be present for the modules that do call them from Kotlin.
  -->
  <PropertyGroup>
    <DatadogBindArtifact Condition=" '$(DatadogBindArtifact)' == '' ">true</DatadogBindArtifact>
    <DatadogResolveArtifactDirectly Condition=" '$(DatadogResolveArtifactDirectly)' == '' ">false</DatadogResolveArtifactDirectly>

    <!--
      @(AndroidMavenLibrary) arrived in the .NET Android SDK 35. The net8.0-android34.0 reference
      pack has no Xamarin.Android.Bindings.Maven.targets at all, so the item is not merely
      unsupported there - it is unknown, and MSBuild ignores unknown items in silence.

      The failure that causes is the worst kind: the build succeeds, the package is produced, and
      the binding assembly inside it is an empty 5 KB shell with no .aar and no types. Nothing in
      the log says so. It is caught here by resolving artifacts a second way on net8, and in
      tests/DatadogNet.Android.PackageTests by asserting every binding assembly is large enough to
      contain a real binding.

      net8 therefore gets no Java dependency verification. That is acceptable because net9 and
      net10 bind exactly the same artifacts and do verify them, so a missing Java dependency still
      fails the build - just in the other two passes.
    -->
    <DatadogSupportsMavenLibrary>true</DatadogSupportsMavenLibrary>
    <!--
      Compared literally rather than with TargetFramework.StartsWith: during the outer
      cross-targeting build $(TargetFramework) is empty, and a property function on it aborts
      evaluation of this file - which leaves TargetFrameworks unset and fails the build with a
      baffling "The TargetFramework value '' was not recognized". The set of target frameworks is
      pinned a few lines above, so an exact match is no less general.
    -->
    <DatadogSupportsMavenLibrary Condition=" '$(TargetFramework)' == 'net8.0-android34.0' ">false</DatadogSupportsMavenLibrary>

    <!--
      A module whose .pom cannot be resolved from Maven Central at all takes the download path on
      every target framework. dd-sdk-android-session-replay-compose imports
      androidx.compose:compose-bom in <dependencyManagement>, and that BOM is published only to
      Google's Maven repository - so resolving it from Central is a 404, reported as XA4237 against
      the Datadog artifact rather than against the BOM that actually failed. A single Repository=
      cannot fix it: the Datadog artifact is on Central and the BOM is not.
    -->
    <DatadogSupportsMavenLibrary Condition=" '$(DatadogResolveArtifactDirectly)' == 'true' ">false</DatadogSupportsMavenLibrary>
  </PropertyGroup>

  <!--
    Every Maven artifact this project needs, declared once and resolved either way. Projects add
    rows for the third-party Java libraries that have no .NET binding.

    Packaging is the file extension on Maven, not the POM's <packaging> element - jctools declares
    'bundle', an OSGi jar, and is published as a .jar.
  -->
  <!--
    Defaults for every @(DatadogMavenArtifact), wherever it is declared. An ItemDefinitionGroup is
    what makes the metadata unconditionally present: referencing %(Repository) on a list where even
    one row omits it is MSB4096, and a project adding a plain Central-hosted .aar should not have
    to spell out the common case to avoid that.
  -->
  <ItemDefinitionGroup>
    <DatadogMavenArtifact>
      <Repository>Central</Repository>
      <Packaging>aar</Packaging>
      <Bind>false</Bind>
    </DatadogMavenArtifact>
  </ItemDefinitionGroup>

  <ItemGroup>
    <DatadogMavenArtifact Include="com.datadoghq:$(DatadogArtifact)"
                          Version="$(DatadogNativeVersion)"
                          Bind="$(DatadogBindArtifact)"
                          Packaging="aar" />
  </ItemGroup>

  <!--
    Projected in a target, not in an ItemGroup here. This file is imported from the middle of each
    .csproj, and MSBuild evaluates a project top to bottom - so an ItemGroup at this point sees
    only the artifacts declared above the Import, and silently misses the third-party rows the
    projects add below it. That produced an XA4241 for a dependency whose artifact was declared six
    lines further down the same file.

    Running after evaluation means the whole @(DatadogMavenArtifact) list is present regardless of
    where a project declares its rows. Version, Repository, Packaging and Bind carry across.
  -->
  <Target Name="ProjectDatadogMavenArtifacts"
          Condition=" '$(DatadogSupportsMavenLibrary)' == 'true' "
          BeforeTargets="_MavenRestore;_VerifyJavaDependencies;_CategorizeAndroidLibraries">
    <ItemGroup>
      <AndroidMavenLibrary Include="@(DatadogMavenArtifact)" />
    </ItemGroup>
  </Target>

  <!--
    The download path. Both the downloads and the @(AndroidLibrary) items live inside the target,
    and paths are made absolute there. $(IntermediateOutputPath) is not final while this file is
    being evaluated - it is imported from the project body, before the .NET SDK's targets have
    appended the configuration and target framework to it - so an item declared at evaluation time
    captures a path that is not where the file ends up. That failure surfaces much later and very
    obscurely, as ExtractJarsFromAar reporting the .aar "is probably corrupt" when in fact it is
    looking in the wrong directory.
  -->
  <Target Name="DownloadDatadogMavenArtifacts"
          Condition=" '$(DatadogSupportsMavenLibrary)' != 'true' "
          BeforeTargets="_MavenRestore;_CategorizeAndroidLibraries">
    <PropertyGroup>
      <_DatadogArtifactDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(IntermediateOutputPath)'))maven</_DatadogArtifactDirectory>
    </PropertyGroup>

    <ItemGroup>
      <_DatadogResolved Include="@(DatadogMavenArtifact)">
        <Group>$([System.Text.RegularExpressions.Regex]::Replace('%(Identity)', ':.*$', ''))</Group>
        <ArtifactId>$([System.Text.RegularExpressions.Regex]::Replace('%(Identity)', '^.*:', ''))</ArtifactId>
      </_DatadogResolved>
      <_DatadogResolved>
        <GroupPath>$([System.String]::Copy('%(Group)').Replace('.', '/'))</GroupPath>
        <BaseUrl Condition=" '%(Repository)' == 'Google' ">https://dl.google.com/dl/android/maven2</BaseUrl>
        <BaseUrl Condition=" '%(Repository)' != 'Google' ">https://repo1.maven.org/maven2</BaseUrl>
      </_DatadogResolved>
      <_DatadogResolved>
        <MavenFileName>%(ArtifactId)-%(Version).%(Packaging)</MavenFileName>
      </_DatadogResolved>
    </ItemGroup>

    <MakeDir Directories="$(_DatadogArtifactDirectory)" />

    <DownloadFile
        SourceUrl="%(_DatadogResolved.BaseUrl)/%(_DatadogResolved.GroupPath)/%(_DatadogResolved.ArtifactId)/%(_DatadogResolved.Version)/%(_DatadogResolved.MavenFileName)"
        DestinationFolder="$(_DatadogArtifactDirectory)"
        SkipUnchangedFiles="true"
        Retries="3" />

    <ItemGroup>
      <AndroidLibrary Include="$(_DatadogArtifactDirectory)/%(_DatadogResolved.MavenFileName)"
                      Bind="%(_DatadogResolved.Bind)" />
    </ItemGroup>
  </Target>

  <!--
    dd-sdk-android publishes its test fixtures as a second Gradle variant of the same module, and
    Gradle flattens both variants into one .pom. The result is that the .pom for core, internal,
    rum, trace and others declares JUnit 5, Mockito, AssertJ, Elmyr, kotlin-reflect and a
    'dd-sdk-android.tools:unit:unspecified' at runtime scope - a coordinate that does not resolve
    anywhere, because it never left Datadog's own build.

    The .module (Gradle module metadata) has the truth: the releaseVariantReleaseRuntimePublication
    variant lists only the real dependencies, and that is what each project below declares. Java
    dependency verification reads the .pom, though, so without these the build fails demanding a
    NuGet binding for JUnit.

    Verified against the 3.12.1 .module; recheck on upgrade, since dropping an entry that upstream
    stops shipping is how a real missing dependency would get silently ignored.
  -->
  <ItemGroup>
    <AndroidIgnoredJavaDependency Include="org.junit.platform:junit-platform-launcher:1.9.3" />
    <AndroidIgnoredJavaDependency Include="org.junit.jupiter:junit-jupiter:5.9.3" />
    <AndroidIgnoredJavaDependency Include="org.junit.vintage:junit-vintage-engine:5.9.3" />
    <AndroidIgnoredJavaDependency Include="org.mockito:mockito-junit-jupiter:5.4.0" />
    <AndroidIgnoredJavaDependency Include="org.mockito.kotlin:mockito-kotlin:5.1.0" />
    <AndroidIgnoredJavaDependency Include="org.assertj:assertj-core:3.27.7" />
    <AndroidIgnoredJavaDependency Include="com.github.xgouchet.Elmyr:core:1.3.1" />
    <AndroidIgnoredJavaDependency Include="com.github.xgouchet.Elmyr:inject:1.3.1" />
    <AndroidIgnoredJavaDependency Include="com.github.xgouchet.Elmyr:junit5:1.3.1" />
    <AndroidIgnoredJavaDependency Include="com.github.xgouchet.Elmyr:jvm:1.3.1" />
    <AndroidIgnoredJavaDependency Include="org.jetbrains.kotlin:kotlin-reflect:2.0.21" />
    <AndroidIgnoredJavaDependency Include="dd-sdk-android.tools:unit:unspecified" />
  </ItemGroup>

  <!--
    Kotlin's stdlib is a runtime dependency of every single module, so it is declared here rather
    than thirteen times.
  -->
  <PropertyGroup>
    <DatadogKotlinStdLibVersion>$(KotlinStdLibVersion)</DatadogKotlinStdLibVersion>
    <DatadogKotlinStdLibVersion Condition=" '$(DatadogSkipNet8)' == 'true' ">$(KotlinStdLibVersionCurrent)</DatadogKotlinStdLibVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Xamarin.Kotlin.StdLib" Version="$(DatadogKotlinStdLibVersion)" />
  </ItemGroup>

  <ItemGroup>
    <TransformFile Include="Transforms/Metadata.xml" Condition="Exists('$(MSBuildProjectDirectory)/Transforms/Metadata.xml')" />
    <TransformFile Include="Transforms/EnumFields.xml" Condition="Exists('$(MSBuildProjectDirectory)/Transforms/EnumFields.xml')" />
    <TransformFile Include="Transforms/EnumMethods.xml" Condition="Exists('$(MSBuildProjectDirectory)/Transforms/EnumMethods.xml')" />
  </ItemGroup>

  <!-- Packaging -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>DatadogNet.$(DatadogPackageName).Android</PackageId>
    <Title>.NET for Android bindings for the native $(DatadogArtifact) module.</Title>
    <PackageTags>$(PackageTags);datadog;observability;SDK;MAUI;Android;dotnet-android;Binding</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../build/icon.png" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" Visible="false" />
    <!--
      Both licence texts the package is covered by: MIT for the binding code in this repository,
      Apache-2.0 for the native artifacts built by Datadog. NOTICE ships too - Apache-2.0 section
      4(d) requires propagating it, and upstream distributes one. Packed into a folder so each file
      keeps its own name; naming the target explicitly would make NuGet treat the extensionless
      LICENSE as a directory.
    -->
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="licenses/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../licenses/Apache-2.0.txt" Pack="true" PackagePath="licenses/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../licenses/NOTICE" Pack="true" PackagePath="licenses/" Visible="false" />
  </ItemGroup>

  <!--
    Consumer R8/ProGuard keep-rules, one pair per package. Packed under buildTransitive/ so NuGet
    imports the .targets into every consuming project - transitive consumers included, which
    build/ would not reach; the rules themselves attach only where R8 runs (see the .targets).
    The .pro files are generated by build/generate-r8-rules.sh and CI regenerates them and fails
    on drift, so what ships is what the script produces.

    Declared here rather than in each .csproj so a package cannot opt out by forgetting the
    block - and deliberately without an Exists() condition, so a new package whose rules were
    never generated fails its pack (NU5019) instead of quietly shipping without them.
  -->
  <ItemGroup>
    <None Include="$(MSBuildProjectDirectory)/buildTransitive/$(PackageId).targets" Pack="true" PackagePath="buildTransitive" />
    <None Include="$(MSBuildProjectDirectory)/buildTransitive/$(PackageId).pro" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

  <!--
    Supply-chain pin for every Maven artifact, on both resolution paths. Java dependency
    verification (above) checks *completeness* - that every linked Java type is provided by some
    referenced package. It says nothing about *authenticity*: whether the bytes resolved from
    Maven Central, or downloaded directly, are the bytes that were reviewed when the version was
    pinned. This target closes that half, against build/maven-checksums.txt - regenerated by
    build/UpdateMavenChecksums.sh on upgrade, so a hash that changes for an unchanged version
    fails the build instead of shipping.

    It verifies the files the build actually resolved - @(AndroidLibrary) after restore covers
    both the @(AndroidMavenLibrary) cache path and the direct-download fallback - so no cache
    layout is guessed at. Only files whose names appear in the pin list are checked; the .aars
    that arrive inside NuGet packages are those packages' responsibility.

    DatadogVerifyMavenChecksums=false skips it, for experiments against unreleased artifacts.
  -->
  <!--
    Scheduling, learned the hard way. BeforeTargets="_CategorizeAndroidLibraries" is what gets
    this target into the build on both resolution paths - the consumer of @(AndroidLibrary)
    always runs. DependsOnTargets="_MavenRestore" is what orders it deterministically after the
    producers: it forces _MavenRestore (and, through that target's own BeforeTargets, the
    direct-download fallback) to have run - or been legitimately skipped - immediately before
    this body. AfterTargets cannot express that: two targets that are both
    BeforeTargets="_CategorizeAndroidLibraries" have no defined order between themselves, and an
    AfterTargets anchor that was skipped never fires at all. The SDK's own
    _VerifyJavaDependencies orders itself with the same DependsOnTargets for the same reason.
    Which producer to depend on is band-specific - see _DatadogVerifyDependsOn just below.
  -->
  <PropertyGroup>
    <!--
      What the verification must wait for is whichever producer this target framework uses. It
      cannot name _MavenRestore unconditionally: the .NET 8 band's Android SDK predates
      @(AndroidMavenLibrary) entirely - the reason the download fallback exists - so the target
      does not exist there and a DependsOnTargets naming it is MSB4057.
    -->
    <_DatadogVerifyDependsOn Condition=" '$(DatadogSupportsMavenLibrary)' == 'true' ">_MavenRestore</_DatadogVerifyDependsOn>
    <_DatadogVerifyDependsOn Condition=" '$(DatadogSupportsMavenLibrary)' != 'true' ">DownloadDatadogMavenArtifacts</_DatadogVerifyDependsOn>
  </PropertyGroup>

  <Target Name="VerifyDatadogMavenArtifactHashes"
          BeforeTargets="_CategorizeAndroidLibraries"
          DependsOnTargets="$(_DatadogVerifyDependsOn)"
          Condition=" '$(DatadogVerifyMavenChecksums)' != 'false' and '$(DesignTimeBuild)' != 'true' ">
    <PropertyGroup>
      <_DatadogChecksumFile>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../build/maven-checksums.txt'))</_DatadogChecksumFile>
    </PropertyGroup>

    <Error Condition=" !Exists('$(_DatadogChecksumFile)') "
           Text="$(_DatadogChecksumFile) is missing. Run build/UpdateMavenChecksums.sh, or set DatadogVerifyMavenChecksums=false to skip verification." />

    <ReadLinesFromFile File="$(_DatadogChecksumFile)">
      <Output TaskParameter="Lines" ItemName="_DatadogChecksumLine" />
    </ReadLinesFromFile>

    <!--
      Everything below is identity-set algebra - transforms, Include and Exclude - deliberately.
      Filtering one item list by another's *metadata* inside a target needs task batching, which
      silently does not apply to an ItemGroup condition written the intuitive way; matching on
      item identity has no such trap. So: pin names become identities, resolved files become
      identities (their file names), the intersection is two Excludes, and a hash mismatch is a
      "name|hash" key present on disk but absent from the pins.
    -->
    <ItemGroup>
      <_DatadogPin Include="@(_DatadogChecksumLine)"
                   Condition=" '%(Identity)' != '' and !$([System.String]::Copy('%(Identity)').StartsWith('#')) ">
        <PinFile>$([System.Text.RegularExpressions.Regex]::Replace('%(Identity)', '\s.*$', ''))</PinFile>
        <Sha256>$([System.Text.RegularExpressions.Regex]::Replace('%(Identity)', '^\S+\s+', ''))</Sha256>
      </_DatadogPin>
      <!-- Re-keyed so the pin's file name IS the identity; Sha256 rides along the transform. -->
      <_DatadogPinName Include="@(_DatadogPin->'%(PinFile)')" />
    </ItemGroup>

    <GetFileHash Files="@(AndroidLibrary->'%(FullPath)')" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_DatadogHashedFile" />
    </GetFileHash>

    <ItemGroup>
      <!-- Identity becomes the bare file name; FileHash metadata rides along the transform. -->
      <_DatadogDisk Include="@(_DatadogHashedFile->'%(Filename)%(Extension)')" />
      <_DatadogNotPinned Include="@(_DatadogDisk)" Exclude="@(_DatadogPinName)" />
      <_DatadogChecked Include="@(_DatadogDisk)" Exclude="@(_DatadogNotPinned)" />

      <_DatadogCheckedKey Include="@(_DatadogChecked->'%(Identity)|%(FileHash)')" />
      <_DatadogExpectedKey Include="@(_DatadogPinName->'%(Identity)|%(Sha256)')" />
      <_DatadogMismatch Include="@(_DatadogCheckedKey)" Exclude="@(_DatadogExpectedKey)" />
    </ItemGroup>

    <Error Condition=" '@(_DatadogChecked)' == '' "
           Text="No resolved Maven artifact matched any pinned name in build/maven-checksums.txt - the pin list is stale for $(DatadogArtifact) $(DatadogNativeVersion). Run build/UpdateMavenChecksums.sh and review the diff." />

    <Error Condition=" '@(_DatadogMismatch)' != '' "
           Text="Maven artifact SHA-256 mismatch: @(_DatadogMismatch->'%(Identity)', '; '). The bytes on disk do not match build/maven-checksums.txt - a corrupted or tampered download, or a stale pin after an upgrade. Investigate before regenerating the pins." />

    <Message Importance="normal"
             Text="Verified @(_DatadogChecked->Distinct()->Count()) Maven artifact hash(es) against build/maven-checksums.txt." />
  </Target>

</Project>
