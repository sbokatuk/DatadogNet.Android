<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <DatadogArtifact>dd-sdk-android-session-replay-compose</DatadogArtifact>
    <DatadogPackageName>SessionReplayCompose</DatadogPackageName>
    <Description>.NET for Android / .NET MAUI bindings for the native Datadog Android SDK's dd-sdk-android-session-replay-compose module: ComposeExtensionSupport, which teaches Session Replay how to record Jetpack Compose content that the view-based recorder sees only as a single opaque surface. Built against dd-sdk-android $(DatadogNativeVersion). Register it with SessionReplayConfiguration.Builder.AddExtensionSupport. Most of this module is Compose extension functions, which do not project into C#; the extension-support type does.</Description>
    <PackageTags>datadog-session-replay;session-replay;compose</PackageTags>
    <!--
      This module's .pom imports androidx.compose:compose-bom, which is published to Google's Maven
      repository and not to Maven Central, so @(AndroidMavenLibrary) cannot resolve it. The .aar is
      downloaded on its own instead - see the comment in Datadog.Binding.props.

      The consequence for this project specifically: no Java dependency verification runs, so the
      PackageReferences below are not checked by the build itself. They were derived from the
      releaseVariantReleaseRuntimePublication variant of the module's Gradle metadata, and
      build/verify-transitive-deps.py re-checks them against that same variant on every CI run -
      so an upgrade that changes the module's dependencies fails there with a named coordinate,
      instead of the by-hand re-derivation this comment used to prescribe.
    -->
    <DatadogResolveArtifactDirectly>true</DatadogResolveArtifactDirectly>

    <!--
      No net8. Compose dropped net8.0-android34.0 at 1.10, and the last version that had it pins
      Xamarin.AndroidX.SavedState to [1.3.3, 1.3.4) - a range that collides with the savedstate
      AndroidX merged savedstate-ktx into, and therefore with what a MAUI 9 app resolves. Pinning
      the whole repository back to that version made every MAUI consumer of every package fail to
      dex; this package dropping net8 costs .NET 8 apps Session Replay for Compose only.
    -->
    <DatadogSkipNet8>true</DatadogSkipNet8>
  </PropertyGroup>

  <Import Project="../Datadog.Binding.props" />

  <ItemGroup>
    <ProjectReference Include="../DatadogNet.SessionReplay.Android/DatadogNet.SessionReplay.Android.csproj"
                      JavaArtifact="com.datadoghq:dd-sdk-android-session-replay:$(DatadogNativeVersion)" />
    <ProjectReference Include="../DatadogNet.Internal.Android/DatadogNet.Internal.Android.csproj"
                      JavaArtifact="com.datadoghq:dd-sdk-android-internal:$(DatadogNativeVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GoogleGson" Version="$(GsonVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Compose.Runtime" Version="$(AndroidXComposeVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Compose.UI" Version="$(AndroidXComposeVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Compose.UI.Tooling" Version="$(AndroidXComposeVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Compose.Material" Version="$(AndroidXComposeVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Navigation.Compose" Version="$(AndroidXNavigationVersion)" />
  </ItemGroup>

</Project>
