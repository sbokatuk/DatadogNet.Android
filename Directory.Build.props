<Project>

  <PropertyGroup>
    <!--
      Package versions are <dd-sdk-android version>.<binding revision>, e.g. 3.12.1.1.

      The first three components are the native Datadog Android SDK inside the package, which is
      also what upstream tags its releases with and what @(AndroidMavenLibrary) resolves from Maven
      Central. The fourth belongs to this repository and increments whenever the bindings or
      packaging change while the native artifacts stay put.

      Every dd-sdk-android module is published in lock-step at one version, so a single property
      covers all thirteen packages - unlike the Gradle plugin, which versions independently and is
      not bound here at all.
    -->
    <DatadogNativeVersion>3.12.1</DatadogNativeVersion>
    <DatadogBindingRevision>2</DatadogBindingRevision>
    <VersionPrefix>$(DatadogNativeVersion).$(DatadogBindingRevision)</VersionPrefix>

  </PropertyGroup>

  <!--
    Versions of the third-party binding packages that supply the Java types dd-sdk-android's .aar
    files link against. Declared once here because several are shared by many of the thirteen
    projects, and a set that disagreed between packages would resolve to whichever NuGet happened
    to pick - AndroidX in particular must be internally consistent or the app fails to dex.

    These are NOT the latest stable versions, for two independent reasons.

    First, the current AndroidX and Kotlin bindings have dropped net8.0-android34.0 and ship
    net9/net10 only, so referencing them fails to restore the net8 pass with NU1202.

    Second, they form a coherent AndroidX generation. Mixing generations - an older Navigation
    against a newer SavedState, say - produces duplicate classes at dex time or unresolvable type
    references at AOT, so these move together or not at all.

    KNOWN INTERACTION WITH MAUI 9. This set resolves slightly above what MAUI 9 is tested against,
    and MAUI 9 does not tolerate that: a plain MAUI 9 app with nothing but
    Xamarin.AndroidX.AppCompat 1.7.1.1 added - no Datadog package anywhere - fails generating Java
    callable wrappers with a NullReferenceException inside the .NET Android SDK. It is an SDK
    defect rather than anything these bindings do, and MAUI 10 is unaffected, which is why the
    sample targets net10.0-android36.0. Trying to stay under MAUI 9's ceiling instead is not
    possible while keeping net8: Fragment 1.8.6.1 pulls Core.Ktx 1.17.0, which pulls Core back
    above it.

    OkHttp carries a second constraint. Datadog's public API exposes okhttp3 types directly -
    Configuration.Builder.setProxy takes an okhttp3.Authenticator, TracingInterceptor extends
    okhttp3.Interceptor - and dd-sdk-android 3.12.1 is compiled against 4.12.0. Square.OkHttp3 5.x
    binds OkHttp 5, whose Interceptor/EventListener surface changed, so it stays on the 4.12.0
    binding that matches what upstream actually built against, regardless of net8.
  -->
  <PropertyGroup>
    <!--
      Embedded by TraceApi (Bind="false") and ignored as already-satisfied by Trace and
      TraceInternal - three projects that must agree on the version or Java dependency
      verification diverges from what actually ships. One property each, so an upgrade is one
      edit, not three.
    -->
    <JctoolsVersion>3.3.0</JctoolsVersion>
    <Re2jVersion>1.7</Re2jVersion>

    <KotlinStdLibVersion>2.2.21</KotlinStdLibVersion>
    <!--
      For packages that have dropped net8 and are therefore not held back. Current Compose requires
      Kotlin 2.4, and asking for 2.2.21 alongside it is a package downgrade rather than a floor.
    -->
    <KotlinStdLibVersionCurrent>2.4.0.1</KotlinStdLibVersionCurrent>
    <OkHttpVersion>4.12.0.10</OkHttpVersion>
    <GsonVersion>2.13.2</GsonVersion>
    <AndroidXAnnotationVersion>1.9.1.5</AndroidXAnnotationVersion>
    <AndroidXCollectionVersion>1.5.0.3</AndroidXCollectionVersion>
    <AndroidXWorkRuntimeVersion>2.11.0</AndroidXWorkRuntimeVersion>
    <AndroidXCoreVersion>1.17.0</AndroidXCoreVersion>
    <AndroidXFragmentVersion>1.8.9</AndroidXFragmentVersion>
    <AndroidXRecyclerViewVersion>1.4.0.3</AndroidXRecyclerViewVersion>
    <!--
      The Navigation family must move together - Navigation.Compose pins Navigation.Common to an
      exact range - but 2.9.6 still has a net8 asset, so there is no reason to hold it back.
      Navigation.Common 2.9.6 asks for SavedState >= 1.4.0, which is a floor rather than a range and
      is satisfied by the SavedState 1.5.x that current Compose brings.
    -->
    <AndroidXNavigationVersion>2.9.6</AndroidXNavigationVersion>
    <AndroidXAppCompatVersion>1.7.1.1</AndroidXAppCompatVersion>
    <AndroidXMultiDexVersion>2.0.1.34</AndroidXMultiDexVersion>
    <GoogleMaterialVersion>1.13.0</GoogleMaterialVersion>
    <!--
      Current, not held back to the last version with a net8 asset (1.9.4). Compose 1.9.4 pins
      SavedState to [1.3.3, 1.3.4), and AndroidX merged savedstate-ktx into savedstate at 1.3 - so
      an app combining it with MAUI's newer AndroidX ends up with both artifacts and D8 refuses to
      dex duplicate androidx.savedstate classes. Holding Compose back to keep net8 broke every MAUI
      consumer of every package, to keep net8 for the one package that needs Compose.

      So DatadogNet.SessionReplayCompose.Android drops net8 instead, and the other twelve packages
      keep it. Only that package references these.
    -->
    <AndroidXComposeVersion>1.11.4</AndroidXComposeVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>s.bokatuk</Authors>
    <Company>s.bokatuk</Company>
    <Copyright>Copyright © s.bokatuk</Copyright>
    <PackageProjectUrl>https://github.com/sbokatuk/DatadogNet.Android</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sbokatuk/DatadogNet.Android</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!--
      One expression for every package: the binding source here is MIT, and every native artifact
      published by Datadog is Apache-2.0. The embedded third-party jars that have no .NET binding -
      Kronos, JCTools, RE2/J, androidx.metrics - are Apache-2.0 or Go-License; see the per-project
      comments and licenses/ for the texts that ship.
    -->
    <PackageLicenseExpression>MIT AND Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition=" '$(GITHUB_ACTIONS)' == 'true' ">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    Surface the curated release notes on nuget.org. docs/release-notes/<version>.md already feeds
    the GitHub release; packing it here is what makes it reach the .nupkg, so nuget.org stops
    showing empty release notes. A version with no curated file - a PR prerelease of unreleased
    work, typically - falls back to the releases page rather than shipping nothing.
  -->
  <PropertyGroup>
    <DatadogReleaseNotesFile>$(MSBuildThisFileDirectory)docs/release-notes/$(VersionPrefix).md</DatadogReleaseNotesFile>
    <PackageReleaseNotes Condition=" Exists('$(DatadogReleaseNotesFile)') ">$([System.IO.File]::ReadAllText('$(DatadogReleaseNotesFile)'))</PackageReleaseNotes>
    <PackageReleaseNotes Condition=" '$(PackageReleaseNotes)' == '' ">https://github.com/sbokatuk/DatadogNet.Android/releases/tag/v$(VersionPrefix)</PackageReleaseNotes>
  </PropertyGroup>

</Project>
